# Copy to .env for local use. Never commit .env. No variable here is a secret in
# the current release; a future licensed data provider's key belongs in the
# host's secret store, not in this file. See spec.md §6.3.

PORT=5000
APP_ENV=development
# Defaults to the first 7 chars of VERCEL_GIT_COMMIT_SHA on Vercel, else "dev".
APP_VERSION=dev

# Comma-separated allowed origins. Empty = same-origin only (CORS off).
CORS_ORIGINS=

# disabled | redfin. Default is disabled (manual entry): enable redfin only after the
# provider-terms review (plan P0-1).
PROPERTY_PROVIDER=disabled
UPSTREAM_CONNECT_TIMEOUT_S=3
UPSTREAM_READ_TIMEOUT_S=8

# Empty disables the app-level limit (only when an edge limiter is in front).
RATE_LIMIT=20/minute
LOG_LEVEL=INFO
