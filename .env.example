# TEMPLATE ONLY. This file is committed to a public repository: NEVER put a real key,
# token, or password in it. Real values belong in your host's secret store (Vercel ->
# Settings -> Environment Variables, marked Sensitive) or in a local, git-ignored `.env`.
# CI fails if a secret-looking variable in this file has a value. See spec.md section 6.3.

PORT=5000
HOST=127.0.0.1
APP_ENV=development
# Defaults to the first 7 chars of VERCEL_GIT_COMMIT_SHA on Vercel, else "dev".
APP_VERSION=dev

# Comma-separated allowed origins. Empty = same-origin only (CORS off).
CORS_ORIGINS=

# census (default) | disabled (turns address lookup off)
GEOCODER=census
UPSTREAM_CONNECT_TIMEOUT_S=3
UPSTREAM_READ_TIMEOUT_S=8

# SECRET. Leave EMPTY here. Empty = home-details lookup off (typical-home fallback).
# The free RentCast plan allows 50 requests/month; each analysis uses one.
RENTCAST_API_KEY=

# Empty disables the app-level limit (only when an edge limiter is in front).
RATE_LIMIT=20/minute
LOG_LEVEL=INFO
